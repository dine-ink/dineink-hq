# Copy to .env and adjust. .env is gitignored; this file is the checked-in
# record of what the app reads.
#
# Everything here is a VITE_* variable, which means Vite inlines it into the
# client bundle at build time. Anything you put in this file is public the
# moment the app ships — never put a secret in one. Secrets belong on the
# backend, behind an authenticated endpoint.

# The DineInk backend this app talks to.
#   local:      http://localhost:5500
#   deployed:   https://dineink-backend.onrender.com
VITE_API_URL=http://localhost:5500

# Chrome extension id for Procurement Intelligence, used to message the
# extension from the Procurement screen. Safe to publish — an extension id is
# visible to anyone who installs it.
VITE_PROCUREMENT_EXTENSION_ID=ojfhfcaaohpjeeimplipeedknjcpbfhh
